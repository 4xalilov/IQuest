{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@iquest/ui": ["packages/ui/src/index.ts"],
      "@iquest/i18n": ["packages/i18n/src/index.ts"],
      "@iquest/tg": ["packages/tg/src/index.ts"],
      "@iquest/engine": ["packages/engine/src/index.ts"]
    }
  },
  "include": ["apps/*/src", "packages/*/src"],
  "exclude": ["apps/api"]
}
